{
  "schemaVersion": 1,
  "id": "femclothes",
  "version": "${version}",
  "name": "FemClothes",
  "description": "Ropa craftable, tenible y compatible con cualquier tono de piel, y una sublimadora que le estampa fotos.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.femclothes.Femclothes",
      "com.femclothes.sublimadora.SublimadoraMod"
    ],
    "client": [
      "com.femclothes.client.FemclothesClient",
      "com.femclothes.sublimadora.SublimadoraModClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21",
    "fabric-api": "*",
    "trinkets": "*",
    "geckolib": ">=4.5.0"
  },
  "accessWidener": "femclothes.accesswidener",
  "mixins": [
    "femclothes.mixins.json"
  ],
  "suggests": {
    "camerapture": "*"
  }
}
